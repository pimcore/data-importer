    "check-types-watch": "tsc --noEmit --watch",
    "build-api-client": "TS_NODE_COMPILER_OPTIONS='{\"moduleResolution\":\"node\"}' npx @rtk-query/codegen-openapi ./build/api/openapi-config.ts"
  },
  "license": "proprietary",
  "private": true,
  "devDependencies": {
